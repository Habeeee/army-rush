

<!DOCTYPE html>

<html lang="ru">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">

<title>Army Rush</title>

<style>

*{box-sizing:border-box}

body{margin:0;overflow:hidden;background:#18251d;font-family:Arial;color:white;touch-action:none}

#game{position:fixed;inset:0}

#ui{position:fixed;inset:0;pointer-events:none}

.top{display:flex;justify-content:space-between;padding:15px;gap:8px}

.panel{background:#101b20dd;padding:10px 14px;border:1px solid #ffffff33;border-radius:12px;font-weight:bold}

#controls{position:absolute;bottom:22px;left:0;right:0;display:flex;justify-content:space-between;align-items:end;padding:15px}

#stick{width:115px;height:115px;border-radius:50%;background:#ffffff22;border:2px solid #ffffff66;pointer-events:auto;position:relative}

#knob{width:48px;height:48px;background:#ffffff99;border-radius:50%;position:absolute;left:31px;top:31px}

.shop{display:flex;flex-direction:column;gap:8px;pointer-events:auto}

button{border:0;border-radius:10px;padding:12px 13px;background:#e0a52e;color:#1b1b1b;font-weight:bold;font-size:13px}

#message{position:absolute;top:45%;width:100%;text-align:center;font-size:26px;font-weight:bold;text-shadow:0 2px 5px black}

#hint{position:absolute;bottom:150px;width:100%;text-align:center;font-size:12px;color:#ddd}

</style>

</head>

<body>

<div id="game"></div>

<div id="ui">

 <div class="top">

  <div class="panel">🪙 <span id="coins">0</span></div>

  <div class="panel">WAVE <span id="wave">1</span></div>

  <div class="panel">❤️ <span id="hp">100</span></div>

 </div>

 <div id="message"></div>

 <div id="hint">Управляй солдатом джойстиком • Стрельба автоматическая</div>

 <div id="controls">

  <div id="stick"><div id="knob"></div></div>

  <div class="shop">

   <button onclick="buySoldier()">+ Солдат · 100</button>

   <button onclick="upgrade()">Урон · 75</button>

   <button onclick="heal()">Лечение · 50</button>

  </div>

 </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>

const scene=new THREE.Scene();

scene.background=new THREE.Color(0x8eb5a0);

scene.fog=new THREE.Fog(0x8eb5a0,25,65);

const camera=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,.1,100);

camera.position.set(0,13,17);

camera.lookAt(0,0,0);

const renderer=new THREE.WebGLRenderer({antialias:true});

renderer.setSize(innerWidth,innerHeight);

renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));

document.getElementById("game").appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff,0x526b43,2));

const sun=new THREE.DirectionalLight(0xffffff,2);

sun.position.set(-5,12,8);scene.add(sun);

const ground=new THREE.Mesh(new THREE.PlaneGeometry(100,100),new THREE.MeshStandardMaterial({color:0x557b45}));

ground.rotation.x=-Math.PI/2;ground.position.y=-.08;scene.add(ground);

const grid=new THREE.GridHelper(100,50,0x72945d,0x72945d);

grid.position.y=-.04;scene.add(grid);

function soldier(color,x,z){

 const g=new THREE.Group();

 const body=new THREE.Mesh(new THREE.BoxGeometry(.65,1,.4),new THREE.MeshStandardMaterial({color}));

 body.position.y=.85;g.add(body);

 const head=new THREE.Mesh(new THREE.SphereGeometry(.25,12,12),new THREE.MeshStandardMaterial({color:0xd5a477}));

 head.position.y=1.55;g.add(head);

 const gun=new THREE.Mesh(new THREE.BoxGeometry(.16,.16,.9),new THREE.MeshStandardMaterial({color:0x222222}));

 gun.position.set(.35,1.05,-.45);g.add(gun);

 g.position.set(x,0,z);scene.add(g);return g;

}

const player=soldier(0x315d9b,0,5);

let allies=[],enemies=[],bullets=[];

let coins=0,hp=100,wave=1,damage=25,dead=false;

let moveX=0,moveY=0,lastShot=0,spawnTimer=0,kills=0;

const $=id=>document.getElementById(id);

function updateUI(){

 $("coins").textContent=coins;$("hp").textContent=hp;$("wave").textContent=wave;

}

function enemy(){

 const x=(Math.random()-.5)*20;

 const e=soldier(0x9c3330,x,-23);

 e.userData.hp=50+wave*12;

 enemies.push(e);

}

function shoot(from,target){

 const start=from.position.clone();start.y+=1;

 const end=target.position.clone();end.y+=1;

 const b=new THREE.Mesh(new THREE.SphereGeometry(.09,8,8),new THREE.MeshBasicMaterial({color:0xffdf67}));

 b.position.copy(start);scene.add(b);

 bullets.push({mesh:b,target,damage:damage,speed:.65});

}

function buySoldier(){

 if(coins<100)return;

 coins-=100;

 const a=soldier(0x3d78b8,(Math.random()-.5)*3,6+Math.random()*2);

 allies.push(a);updateUI();

}

function upgrade(){

 if(coins<75)return;

 coins-=75;damage+=10;updateUI();

}

function heal(){

 if(coins<50||hp>=100)return;

 coins-=50;hp=Math.min(100,hp+30);updateUI();

}

const stick=$("stick"),knob=$("knob");

let active=false,center={x:0,y:0};

function pointerStart(e){

 active=true;const r=stick.getBoundingClientRect();

 center={x:r.left+r.width/2,y:r.top+r.height/2};

 pointerMove(e);

}

function pointerMove(e){

 if(!active)return;

 const dx=e.clientX-center.x,dy=e.clientY-center.y;

 const len=Math.max(1,Math.hypot(dx,dy));

 moveX=dx/Math.max(45,len);moveY=dy/Math.max(45,len);

 knob.style.left=(31+moveX*32)+"px";

 knob.style.top=(31+moveY*32)+"px";

}

function pointerEnd(){

 active=false;moveX=0;moveY=0;knob.style.left="31px";knob.style.top="31px";

}

stick.addEventListener("pointerdown",e=>{stick.setPointerCapture(e.pointerId);pointerStart(e)});

stick.addEventListener("pointermove",pointerMove);

stick.addEventListener("pointerup",pointerEnd);

stick.addEventListener("pointercancel",pointerEnd);

function nearest(from){

 let best=null,dist=Infinity;

 enemies.forEach(e=>{

  const d=from.position.distanceTo(e.position);

  if(d<dist){dist=d;best=e;}

 });

 return best;

}

function animate(){

 requestAnimationFrame(animate);

 if(!dead){

  player.position.x+=moveX*.13;

  player.position.z+=moveY*.13;

  player.position.x=Math.max(-13,Math.min(13,player.position.x));

  player.position.z=Math.max(-5,Math.min(12,player.position.z));

  camera.position.x+=(player.position.x-camera.position.x)*.04;

  camera.position.z+=(player.position.z+12-camera.position.z)*.04;

  camera.lookAt(player.position.x,0,player.position.z-3);

  allies.forEach((a,i)=>{

   const target=nearest(a);

   if(target&&Date.now()-a.userData.shot>1000){

    shoot(a,target);a.userData.shot=Date.now();

   }

   a.position.x=player.position.x+(i%2?1.5:-1.5);

   a.position.z=player.position.z+2+Math.floor(i/2)*1.5;

  });

  if(Date.now()-lastShot>650){

   const target=nearest(player);

   if(target){shoot(player,target);lastShot=Date.now();}

  }

  spawnTimer++;

  if(spawnTimer>Math.max(35,100-wave*4)){

   enemy();spawnTimer=0;

  }

  bullets.forEach((b,i)=>{

   if(!b.target||!enemies.includes(b.target)){

    scene.remove(b.mesh);bullets.splice(i,1);return;

   }

   const dir=b.target.position.clone().add(new THREE.Vector3(0,1,0)).sub(b.mesh.position).normalize();

   b.mesh.position.addScaledVector(dir,b.speed);

   if(b.mesh.position.distanceTo(b.target.position.clone().add(new THREE.Vector3(0,1,0)))<.7){

    b.target.userData.hp-=b.damage;

    scene.remove(b.mesh);bullets.splice(i,1);

    if(b.target.userData.hp<=0){

     scene.remove(b.target);enemies=enemies.filter(e=>e!==b.target);

     coins+=15;kills++;

     if(kills>=wave*8){wave++;kills=0;}

     updateUI();

    }

   }

  });

  enemies.forEach(e=>{

   const dir=player.position.clone().sub(e.position).normalize();

   e.position.addScaledVector(dir,.025+wave*.002);

   if(e.position.distanceTo(player.position)<1.3){

    hp-=.15;

    $("hp").textContent=Math.max(0,Math.floor(hp));

    if(hp<=0){dead=true;$("message").innerHTML="GAME OVER<br><button onclick='location.reload()'>ИГРАТЬ СНОВА</button>";}

   }

  });

 }

 renderer.render(scene,camera);

}

updateUI();animate();

window.addEventListener("resize",()=>{

 camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();

 renderer.setSize(innerWidth,innerHeight);

});

</script>

</body>

</html>
